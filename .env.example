# Hugging Face Inference Providers token — https://huggingface.co/settings/tokens
HF_TOKEN=

# ElevenLabs text-to-speech — https://elevenlabs.io
ELEVENLABS_API_KEY=
# Optional: a premade voice id; defaults to "George" (JBFqnCBsd6RMkjVDRZzb)
ELEVENLABS_VOICE_ID=

# Podcast Index REST API — https://api.podcastindex.org
PODCASTINDEX_KEY=
PODCASTINDEX_SECRET=

# Optional model overrides (defaults shown)
# CHAT_MODEL=meta-llama/Llama-3.1-8B-Instruct
# ASR_MODEL=openai/whisper-large-v3
# SUMMARY_MODEL=facebook/bart-large-cnn
# IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
